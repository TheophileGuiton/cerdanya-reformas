# Copy to .env.local and fill in. Never commit .env.local.

NEXT_PUBLIC_SITE_URL=https://www.cerdanyareformes.com   # TO CONFIRM domain
NEXT_PUBLIC_PHONE=+34 625 01 43 88
NEXT_PUBLIC_WHATSAPP_NUMBER=34625014388      # international format, digits only
NEXT_PUBLIC_PARENT_URL=https://cerdanyaprive.com

# Lead form
RESEND_API_KEY=
CONTACT_FROM_EMAIL=web@cerdanyareformes.com          # verified domain in Resend
CONTACT_TO_EMAIL=
LEAD_WEBHOOK_URL=                           # optional: Google Sheet / CRM webhook

# Anti-spam (Cloudflare Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Analytics (loaded only after consent)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=

# Optional: Context7 higher rate limits
CONTEXT7_API_KEY=

# Lead form testing. With LEAD_DRY_RUN=true nothing is sent: the email is only
# written to the server log. For a real send test use Resend's test addresses:
#   CONTACT_FROM_EMAIL=onboarding@resend.dev   CONTACT_TO_EMAIL=delivered@resend.dev
LEAD_DRY_RUN=
